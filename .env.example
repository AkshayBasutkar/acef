NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=acef_password

CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

CACHE_SIMILARITY_THRESHOLD=0.92  # Calibrated via cache_pairs.jsonl sweep (see docs/benchmark_results.md); zero false hits on hard negatives
MEMORY_TOP_K=5
MEMORY_LONG_CONVERSATION_TURNS=3
DOC_ROUTE_THRESHOLD=0.45
MEMORY_RELEVANCE_FLOOR=0.30
MAX_CONTEXT_CHARS=6000
GRAPH_SOURCE_MAX_CHARS=1200
ALLOWED_INGEST_ROOTS=["*"]
MAX_UPLOAD_BYTES=10485760

# ── Query Classifier ─────────────────────────────────────────────────────────
# "heuristic" (default, zero latency) | "llm" (accurate, uses Gemini/Groq) | "local" (future MiniLM)
CLASSIFIER_MODE=heuristic
# Override the model used specifically for classification (leave blank for provider default):
#   gemini → gemini-2.0-flash-lite   groq → llama-3.1-8b-instant
CLASSIFIER_MODEL=
# Path to fine-tuned local classifier weights (only needed when CLASSIFIER_MODE=local)
CLASSIFIER_LOCAL_MODEL_PATH=
